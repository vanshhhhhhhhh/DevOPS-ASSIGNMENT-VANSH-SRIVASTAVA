# SINGLE-STAGE version (for comparison).
# Everything happens in one image based on the full node:24 image (Debian with
# python3, make, g++ and git, which is what you need to build most Node projects).
# The final image therefore also contains: the build toolchain, TypeScript and
# @types/node (dev dependencies), the .ts sources and the npm cache.
# Base image: official node:24 via the AWS ECR Public mirror of Docker Hub.
FROM public.ecr.aws/docker/library/node:24

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

ENV NODE_ENV=production PORT=3000 IMAGE_VARIANT=single-stage
EXPOSE 3000
CMD ["node", "dist/server.js"]
